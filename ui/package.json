{
  "name": "kkrepo-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "kkRepo admin and browse UI built with Vue 3 and MICL (Material Design 3 Expressive).",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:admin",
    "build:admin": "npm run build:themes && npm run build:icons && vite build && node scripts/prepare-output.mjs admin",
    "build:browse": "npm run build:themes && npm run build:icons && vite build --mode browse && node scripts/prepare-output.mjs browse",
    "preview": "vite preview",
    "build:themes": "node scripts/build-themes.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "material-inspired-component-library": "10.0.0",
    "material-symbols": "0.48.1",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@material/material-color-utilities": "^0.3.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "subset-font": "^2.9.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
